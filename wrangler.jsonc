{
  "name": "filecodebox",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ADMIN_PASSWORD": "admin123",
    "MAX_FILE_SIZE": "104857600",
    "DEFAULT_EXPIRE_DAYS": "7",
    "UUID": "your-uuid-here",
    "PROXYIP": "proxyip.edgetunnel.workers.dev",
    "HOST": "your-proxy-host.example.com"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "filecodebox-db",
    "database_id": "64ed02dd-5ce9-4c8b-9ef3-005542ac6389"
  }],
  "kv_namespaces": [{
    "binding": "FILE_STORE",
    "id": "c1b91b7c590f41138f985965ddc9b3dc"
  },
  {
    "binding": "KV",
    "id": "c1b91b7c590f41138f985965ddc9b3dc"
  }]
}
