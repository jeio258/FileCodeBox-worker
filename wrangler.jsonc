{
  "name": "filecodebox",
  "main": "src/index.ts",
  "account_id": "ea2143f29e816a521fc066bda417c798",
  "compatibility_date": "2025-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    { "pattern": "ooo.994613.xyz/*", "zone_name": "994613.xyz" },
    { "pattern": "vvv.994613.xyz/*", "zone_name": "994613.xyz" }
  ],
  "vars": {
    "ADMIN_PASSWORD": "admin123",
    "MAX_FILE_SIZE": "104857600",
    "DEFAULT_EXPIRE_DAYS": "7"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "filecodebox-db",
    "database_id": "64ed02dd-5ce9-4c8b-9ef3-005542ac6389"
  }],
  "r2_buckets": [{
    "binding": "FILE_STORE",
    "bucket_name": "filecodebox"
  }]
}
